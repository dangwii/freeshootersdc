<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout Optimizado para el Modo Multijugador de FreeShooter SDC.
    Incorpora controles ergonómicos a los lados y botón de salida/pausa superior.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Vista de la cámara real de fondo -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewViewMulti"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Zona de toques interactivos transparente -->
    <FrameLayout
        android:id="@+id/multiplayerGameArea"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent" />

    <!-- MARCADOR DE DUELO EN LA PARTE SUPERIOR (Tú vs Rival) -->
    <LinearLayout
        android:id="@+id/hudScoreboard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#99000000"
        android:padding="12dp"
        android:baselineAligned="false"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnMultiPause"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Tu puntuación -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TÚ"
                android:textColor="#2196F3"
                android:textSize="12sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tvMyScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Tiempo de la partida multijugador -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TIEMPO"
                android:textColor="#FF5252"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/tvMultiTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="45s"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Puntuación del rival -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RIVAL"
                android:textColor="#FF9800"
                android:textSize="12sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tvRivalScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/btnMultiPause"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SALIR"
        android:textColor="#FFFFFF"
        android:backgroundTint="#A0000000"
        android:textStyle="bold"
        app:cornerRadius="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- CONTROLES LATERALES ERGONÓMICOS -->

    <!-- Lado Izquierdo: Munición y botón de Recargar -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#A0000000"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/hudScoreboard">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BALAS"
            android:textColor="#A0A0A0"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMultiAmmo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="8/8"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnMultiReload"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="110dp"
            android:layout_height="60dp"
            android:text="RECARGAR"
            android:textColor="#2196F3"
            android:textSize="12sp"
            android:textStyle="bold"
            app:strokeColor="#2196F3"
            app:cornerRadius="30dp" />
    </LinearLayout>

    <!-- Lado Derecho: Botón de Ataque Láser grande para el pulgar derecho -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnMultiPause">

        <Button
            android:id="@+id/btnMultiShoot"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:backgroundTint="#2196F3"
            android:text="⚡\n¡FUEGO!"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="55dp" />
    </LinearLayout>

    <!-- Puntero o mira del duelo multijugador fijada en el centro -->
    <ImageView
        android:id="@+id/ivMultiCrosshair"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:src="@android:drawable/ic_menu_myplaces"
        android:contentDescription="Mira central multijugador"
        app:tint="#2196F3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>